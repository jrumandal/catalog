{
  "name": "@jrumandal/catalog",
  "version": "0.0.1",
  "description": "Catalog micro-frontend (Angular 20, standalone component + @angular/elements custom element + SSR). Source-only ESM package consumed by the shell.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node -e \"console.log('@jrumandal/catalog is source-only (no build step).')\"",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@jrumandal/bridge": "workspace:*",
    "@jrumandal/contracts": "workspace:*",
    "@jrumandal/design-tokens": "workspace:*",
    "@jrumandal/event-bus": "workspace:*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/elements": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "rxjs": "^7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/elements": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "9.39.5",
    "jsdom": "^26.1.0",
    "rxjs": "^7.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0",
    "zone.js": "~0.15.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
